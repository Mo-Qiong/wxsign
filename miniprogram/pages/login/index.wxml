<view class="login-container">
  <view class="header">
    <view class="title">查课管理系统</view>
    <view class="subtitle">欢迎使用，请先绑定学号</view>
  </view>
  
  <view class="form-container">
    <t-input
      label="姓名"
      placeholder="请输入真实姓名"
      value="{{name}}"
      bind:change="onNameChange"
    />
    <t-input
      label="学号"
      placeholder="请输入学号"
      value="{{studentId}}"
      bind:change="onStudentIdChange"
    />
    
    <view class="btn-container">
      <t-button theme="primary" size="large" block bind:tap="handleLoginAndBind">微信一键登录并绑定</t-button>
    </view>
  </view>
  <t-toast id="t-toast" />
  <t-message id="t-message" />
</view>
