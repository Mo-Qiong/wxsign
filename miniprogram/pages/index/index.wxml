<view class="container">
  <view class="header-section">
    <view class="welcome-text">你好，{{userInfo.name || '同学'}}</view>
    <view class="role-tag" wx:if="{{userInfo.role}}">{{roleName}}</view>
  </view>

  <!-- 志愿者入口 -->
  <view class="action-card" wx:if="{{isVolunteer}}" bind:tap="goToTaskList">
    <t-icon name="check-circle" size="48rpx" color="#3B82F6" />
    <view class="card-content">
      <view class="card-title">查课任务</view>
      <view class="card-desc">查看并执行分配给您的查课任务</view>
    </view>
    <t-icon name="chevron-right" size="48rpx" color="#CBD5E1" />
  </view>

  <!-- 管理员入口 -->
  <view class="action-card" wx:if="{{isAdmin}}" bind:tap="goToAdminPanel">
    <t-icon name="setting" size="48rpx" color="#3B82F6" />
    <view class="card-content">
      <view class="card-title">管理专区</view>
      <view class="card-desc">考勤审核与排班调整</view>
    </view>
    <t-icon name="chevron-right" size="48rpx" color="#CBD5E1" />
  </view>
</view>